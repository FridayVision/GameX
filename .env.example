# ── App ───────────────────────────────────────────────────────────────────────
# Public URL of the deployed app — used to lock Socket.IO CORS to your domain.
# In development this can be omitted (falls back to allowing all origins).
# On Railway: set to your deployed URL e.g. https://gamex.up.railway.app
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# ── Required ──────────────────────────────────────────────────────────────────
# TMDB — https://www.themoviedb.org/settings/api
# Use the "API Key (v3 auth)" value. Required for pool generation.
TMDB_API_KEY=your_tmdb_api_key_here

# ── Optional but recommended ──────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/app/apikey
# Enables LLM-powered pool synthesis and ranking.
# Falls back to keyword classification if omitted.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Brave Search — https://api.search.brave.com/
# Adds web search as an additional pool source.
# Pool generation continues without it.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
